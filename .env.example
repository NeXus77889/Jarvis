GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

JARVIS_DEBUG=False
JARVIS_MEMORY_ENABLED=True
JARVIS_MAX_HISTORY=12
JARVIS_MAX_MEMORY_RESULTS=5
JARVIS_MAX_CONTEXT_TOKENS=6000
JARVIS_MAX_MEMORY_TOKENS=1200
JARVIS_MAX_RESPONSE_TOKENS=1200
JARVIS_LOG_LEVEL=INFO
# Optional Vosk model directory for offline wake word (CPU only)
# JARVIS_VOSK_MODEL_PATH=C:\Users\YourName\Models\vosk-model
# Optional root directory for safe, read-only project file tools
# JARVIS_WORKSPACE=C:\Users\YourName\Projects
# Optional read-only SQLite/MySQL/PostgreSQL integration. Use a database account with SELECT-only grants.
# JARVIS_PROJECT_DB_PATH=C:\Users\YourName\Projects\project.sqlite3
# JARVIS_PROJECT_DB_TABLES=projects,tasks
# For MySQL: JARVIS_PROJECT_DB_PATH=mysql+pymysql://user:password@localhost/project_db
# For PostgreSQL: JARVIS_PROJECT_DB_PATH=postgresql+psycopg://user:password@localhost/project_db
# Optional. Defaults to storage/memory/jarvis_memory.db
# JARVIS_DATABASE_PATH=
